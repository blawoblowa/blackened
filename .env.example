# Konfigurasi API AbuseIPDB (Opsional)
# Dapatkan API Key gratis (1.000 query/hari) di https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# Konfigurasi Auto Commit & Push GitHub (Opsional: true / false)
AUTO_GIT_PUSH=false

# Token GitHub Personal Access Token (PAT) untuk otentikasi git push (khususnya saat jalan di Docker)
# Buat di https://github.com/settings/tokens (pilih repo / contents:write)
GITHUB_TOKEN=

# Identitas Git commit (Opsional)
GIT_USER_NAME=
GIT_USER_EMAIL=
